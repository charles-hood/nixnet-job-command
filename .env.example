# Optional integrations. Copy to .env and fill only what you use.
# Never commit real values. The app also reads chmod-600 files under data/.

# Bind and port (defaults: 127.0.0.1 and 8742)
# NJC_PORT=8742
# NJC_BIND=127.0.0.1
# NJC_DATA=./data
# NJC_PROFILE=./profile.json
# NJC_TIMEZONE=America/New_York
# NJC_DAILY_GOAL=5

# JCC_* aliases work too, for compatibility with older launch units.
# JCC_PORT=8742
# JCC_BIND=127.0.0.1
# JCC_DATA=./data

# Optional: allow a Crustdata key so the UI can offer live "Find contacts".
# Lookups can also stay agent-driven: your assistant searches, then POSTs
# contacts to /api/jobs/<ref>/contacts. No one is messaged automatically.
# CRUSTDATA_API_KEY=

# Optional: a helper that matches Gmail application receipts to jobs and
# writes gmail_receipt_url / date_applied. The app itself does not send mail.
# GMAIL_RECEIPTS=1
